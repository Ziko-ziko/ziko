{
  "name": "ziko-video-studio",
  "version": "1.0.0",
  "private": true,
  "description": "Video editing, animation & motion graphics toolkit (Remotion + Hyperframes + ffmpeg)",
  "scripts": {
    "studio": "remotion studio src/index.ts",
    "render": "remotion render src/index.ts",
    "render:intro": "remotion render src/index.ts TitleIntro out/title-intro.mp4",
    "render:lowerthird": "remotion render src/index.ts LowerThird out/lower-third.mov --codec=prores --prores-profile=4444 --pixel-format=yuva444p10le --image-format=png",
    "render:vertical": "remotion render src/index.ts TitleIntroVertical out/title-intro-vertical.mp4",
    "render:reel1-4k": "remotion render src/index.ts Reel1 out/reel1_4k.mp4 --scale=2 --crf=14 --x264-preset=slow",
    "render:theatre": "remotion render src/index.ts TheatreScene out/theatre-scene.mp4",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fontsource/abril-fatface": "^5.3.0",
    "@fontsource/biryani": "^5.3.0",
    "@fontsource/cinzel": "^5.3.0",
    "@fontsource/josefin-sans": "^5.3.0",
    "@fontsource/league-gothic": "^5.3.0",
    "@fontsource/league-spartan": "^5.3.0",
    "@fontsource/montserrat": "^5.3.0",
    "@fontsource/open-sans": "^5.3.0",
    "@fontsource/oswald": "^5.3.0",
    "@fontsource/playfair-display": "^5.3.0",
    "@fontsource/poppins": "^5.3.0",
    "@fontsource/quicksand": "^5.3.0",
    "@fontsource/raleway": "^5.3.0",
    "@fontsource/roboto-slab": "^5.3.0",
    "@fontsource/sacramento": "^5.3.0",
    "@fontsource/shrikhand": "^5.3.0",
    "@fontsource/six-caps": "^5.3.0",
    "@fontsource/vidaloka": "^5.3.0",
    "@fontsource/yellowtail": "^5.3.0",
    "@remotion/captions": "4.0.533",
    "@remotion/cli": "4.0.533",
    "@remotion/fonts": "4.0.533",
    "@remotion/google-fonts": "4.0.533",
    "@remotion/lottie": "4.0.533",
    "@remotion/media-utils": "4.0.533",
    "@remotion/motion-blur": "4.0.533",
    "@remotion/noise": "4.0.533",
    "@remotion/paths": "4.0.533",
    "@remotion/player": "4.0.533",
    "@remotion/shapes": "4.0.533",
    "@remotion/transitions": "4.0.533",
    "@remotion/zod-types": "4.0.533",
    "@theatre/core": "^0.7.2",
    "@theatre/studio": "^0.7.2",
    "gsap": "^3.15.0",
    "hyperframes": "^0.8.138",
    "lottie-web": "^5.12.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "remotion": "4.0.533",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "typescript": "^5.6.0"
  }
}
